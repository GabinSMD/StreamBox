{
  "manifest_version": 3,
  "name": "StreamBox · Musiques des redifs",
  "version": "1.1.1",
  "description": "Affiche la musique qui passait pendant le live dans une rediffusion Twitch ou YouTube, et peut la jouer en synchro (chaînes qui utilisent StreamBox).",
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "musiques-redifs@streambox",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "player.html"
      ],
      "matches": [
        "https://www.twitch.tv/*",
        "https://www.youtube.com/*"
      ]
    }
  ]
}
